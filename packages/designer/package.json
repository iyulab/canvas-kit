{
  "name": "@canvas-kit/designer",
  "version": "0.4.0",
  "description": "Complete canvas editor UI powered by Konva.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/canvas-kit.git",
    "directory": "packages/designer"
  },
  "bugs": {
    "url": "https://github.com/iyulab/canvas-kit/issues"
  },
  "homepage": "https://github.com/iyulab/canvas-kit#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --external react --external react-dom --external konva --external react-konva --external @canvas-kit/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "echo 'ESLint configuration in progress'"
  },
  "dependencies": {
    "@canvas-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "konva": "^10.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-konva": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "konva": "^10.7.0",
    "postcss": "^8.5.28",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "tsup": "^8.5.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
