{
  "name": "@canvas-kit/viewer",
  "version": "0.4.0",
  "description": "Lightweight HTML viewer for canvas-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/canvas-kit.git",
    "directory": "packages/viewer"
  },
  "bugs": {
    "url": "https://github.com/iyulab/canvas-kit/issues"
  },
  "homepage": "https://github.com/iyulab/canvas-kit#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react --external react-dom --external @canvas-kit/core",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@canvas-kit/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "postcss": "^8.5.28",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
