{
  "name": "@canvas-kit/core",
  "version": "0.3.0",
  "description": "UI-independent data engine for canvas-kit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyulab/canvas-kit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/iyulab/canvas-kit/issues"
  },
  "homepage": "https://github.com/iyulab/canvas-kit#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vitest-canvas-mock": "^1.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}