// Lint configuration (oxlint). oxlint parses TypeScript itself, so it works with the native
// TypeScript 7 compiler, which typescript-eslint cannot load.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // A React Compiler-era render-performance heuristic, not a correctness rule: it flags the
    // reset-on-input and load-on-mount effects this codebase uses on purpose. The hooks gate is
    // the classic pair above.
    "react/set-state-in-effect": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.next/**", "**/out/**", "**/coverage/**"]
}
